@startuml
' Sơ đồ LỚP của module Dashboard: các lớp, chúng gọi nhau thế nào, thuộc tầng nào.
' Quy ước mũi tên:  A --> B  : A dùng/gọi B     A ..|> B : A cài đặt giao diện B     A *-- B : A chứa B
' Dòng bên dưới chọn bộ vẽ có sẵn trong PlantUML nên KHÔNG cần cài Graphviz.
!pragma layout smetana
title Sơ đồ lớp module Dashboard
hide empty members
skinparam classAttributeIconSize 0

package "com.gym.app (khung ứng dụng)" {
  interface AppModule {
    + getId() : String
    + getTitle() : String
    + getAllowedRoles() : Set<StaffRole>
    + createPanel() : JPanel
  }
  class Session {
    + {static} getRole() : StaffRole
  }
}

package "com.gym.dashboard" {
  class DashboardModule {
    + createPanel() : JPanel
  }

  package "ui (giao diện)" {
    class DashboardPanel {
      + refresh()
    }
    class StatCard {
      + setValue(text : String)
      + clear()
    }
    class MonthlyRevenueChartPanel {
      + setData(data : List<MonthlyRevenue>)
    }
    class MaintenanceCostChartPanel {
      + setData(data : List<MonthlyMaintenanceCost>)
    }
    class ClassOccupancyChartPanel {
      + setData(data : List<ClassOccupancy>)
    }
    class EquipmentStatusChartPanel {
      + setData(data : List<EquipmentStatusCount>)
    }
  }

  package "service (luật nghiệp vụ)" {
    class DashboardService {
      + {static} EXPIRING_DAY_OPTIONS : List<Integer> = [7, 30]
      + activeMembers() : int
      + monthlyRevenue() : BigDecimal
      + expiringMemberships(days : int) : int
      + classToday() : int
      + monthlyRevenueChart() : List<MonthlyRevenue>
      + monthlyMaintenanceCostChart() : List<MonthlyMaintenanceCost>
      + classOccupancyThisWeek() : List<ClassOccupancy>
      + equipmentByStatus() : List<EquipmentStatusCount>
      + {static} requireAccess(role : StaffRole)
      + {static} requireFinanceAccess(role : StaffRole)
    }
  }

  package "dao (truy vấn)" {
    class DashboardDao {
      + countActiveMembers(today : LocalDate) : int
      + sumMonthlyRevenue(today : LocalDate) : BigDecimal
      + countExpiringMemberships(today : LocalDate, days : int) : int
      + countClassToday(today : LocalDate) : int
      + sumRevenueByMonth(today, months) : List<MonthlyRevenue>
      + sumMaintenanceCostByMonth(today, months) : List<MonthlyMaintenanceCost>
      + classOccupancyByDay(weekStart) : List<ClassOccupancy>
      + countEquipmentByStatus() : List<EquipmentStatusCount>
    }
  }

  package "model" {
    class MonthlyRevenue <<record>> {
      month : YearMonth
      revenue : BigDecimal
    }
    class MonthlyMaintenanceCost <<record>> {
      month : YearMonth
      cost : BigDecimal
    }
    class ClassOccupancy <<record>> {
      date : LocalDate
      seatsTaken : int
      capacity : int
      + percent() : double
    }
    class EquipmentStatusCount <<record>> {
      status : EquipmentStatus
      count : int
    }
  }
}

package "com.gym.core" {
  class DBConnection {
    + {static} getConnection() : Connection
  }
  class Async <<UiKit>> {
    + {static} run(owner, work, onSuccess)
  }
  enum EquipmentStatus {
    ACTIVE
    UNDER_MAINTENANCE
    BROKEN
  }
}

DashboardModule ..|> AppModule
DashboardModule --> DashboardPanel : tạo màn hình
DashboardPanel *-- "4" StatCard : 4 thẻ số liệu
DashboardPanel *-- MonthlyRevenueChartPanel : biểu đồ 1 (chỉ Quản lý)
DashboardPanel *-- MaintenanceCostChartPanel : biểu đồ 4 (chỉ Quản lý)
DashboardPanel *-- ClassOccupancyChartPanel : biểu đồ 3
DashboardPanel *-- EquipmentStatusChartPanel : biểu đồ 2
DashboardPanel --> DashboardService : chỉ gọi Service
DashboardPanel ..> Async : chạy việc nền
DashboardService --> DashboardDao
DashboardService ..> Session : đọc vai trò
DashboardDao ..> DBConnection : mở kết nối
DashboardDao ..> MonthlyRevenue : tạo
DashboardDao ..> MonthlyMaintenanceCost : tạo
DashboardDao ..> ClassOccupancy : tạo
DashboardDao ..> EquipmentStatusCount : tạo
MonthlyRevenueChartPanel ..> MonthlyRevenue : vẽ từ
MaintenanceCostChartPanel ..> MonthlyMaintenanceCost : vẽ từ
ClassOccupancyChartPanel ..> ClassOccupancy : vẽ từ
EquipmentStatusChartPanel ..> EquipmentStatusCount : vẽ từ
EquipmentStatusCount --> EquipmentStatus
@enduml
